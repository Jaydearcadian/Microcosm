# Arc Configuration
ARC_NETWORK=testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_MAINNET_RPC_URL=
DATABASE_URL=

# Wallet Configuration
PRIVATE_KEY=your_wallet_private_key_here
ARC_SETTLEMENT_PRIVATE_KEY=
ARC_SETTLEMENT_DEPLOYER_PRIVATE_KEY=
ARC_CLAIM_ESCROW_OWNER=
ARC_SETTLEMENT_ROUTER_ADDRESS=
ARC_CLAIM_ESCROW_ADDRESS=

# Circle Console Keys (for Swap functionality)
# Get your free kit key at: https://console.circle.com -> Keys -> Kit Keys
KIT_KEY=your_kit_key_here

# Circle Wallets Configuration (optional - for developer-controlled wallets)
# CIRCLE_API_KEY=PREFIX:ID:SECRET
# CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret
# EVM_WALLET_ADDRESS=your_developer_controlled_wallet_address

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# XMTP
XMTP_ENV=dev

# Market Adapters
ENABLED_MARKETS=myriad,polymarket,hyperliquid,lighter

# Venue API Keys
POLYMARKET_API_KEY=
MYRIAD_API_KEY=
HYPERLIQUID_API_KEY=
LIGHTER_API_KEY=

# Data Providers
ALLIUM_API_KEY=
UNIBLOCK_API_KEY=
